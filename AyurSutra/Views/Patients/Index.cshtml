@model IEnumerable<AyurSutra.Models.Patient>

@{
    Layout = null;
    ViewData["Title"] = "Patient Management - AyurSutra";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Management | AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'DM Sans', sans-serif;
        }

        h1, h2 {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>

<body class="bg-[#f5f6f0] text-[#263c2d]">

    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="w-64 bg-[#285b3b] text-white p-6 hidden md:flex flex-col">
            <a href="/Dashboard/Index" class="text-2xl font-bold mb-12">AyurSutra</a>

            <p class="text-xs uppercase tracking-widest text-[#c4d7c5] mb-4">
                Management
            </p>

            <nav class="space-y-3">
                <a href="/Dashboard/Index" class="block px-4 py-3 rounded-lg hover:bg-[#3b7650]">
                    Dashboard
                </a>

                <a href="/Patients/Index" class="block bg-[#3b7650] px-4 py-3 rounded-lg">
                    Patients
                </a>

                <a href="/Doctors/Index" class="block px-4 py-3 rounded-lg hover:bg-[#3b7650]">
                    Doctors
                </a>

                <a href="/Therapies/Index" class="block px-4 py-3 rounded-lg hover:bg-[#3b7650]">
                    Therapies
                </a>

                <a href="/Appointments/Index" class="block px-4 py-3 rounded-lg hover:bg-[#3b7650]">
                    Appointments
                </a>

                <a href="/TreatmentRecords/Index" class="block px-4 py-3 rounded-lg hover:bg-[#3b7650]">
                    Treatment Records
                </a>
            </nav>

            <div class="mt-auto pt-8">
                <a href="/Account/Logout"
                   class="block text-center bg-white text-[#285b3b] py-3 rounded-lg font-semibold">
                    Logout
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-6 md:p-10">

            <div class="mb-8">
                <p class="text-sm text-gray-500">Management / Patients</p>
                <h1 class="text-4xl mt-2">Patient Management</h1>
                <p class="text-gray-500 mt-2">
                    View and manage registered patient information.
                </p>
            </div>

            <!-- Search and Add Patient -->
            <div class="bg-white p-5 rounded-xl shadow-sm mb-6">
                <div class="flex flex-col md:flex-row justify-between gap-4">

                    <form method="get" action="/Patients/Index"
                          class="flex flex-1 gap-2">

                        <input type="text" name="searchString"
                               value="@ViewBag.SearchString"
                               placeholder="Search by name or phone number..."
                               class="flex-1 min-w-0 border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">

                        <button type="submit"
                                class="bg-[#285b3b] text-white px-6 py-3 rounded-lg">
                            Search
                        </button>
                    </form>

                    <a href="/Patients/Create"
                       class="bg-[#285b3b] text-white px-6 py-3 rounded-lg text-center font-semibold">
                        + Add Patient
                    </a>

                </div>
            </div>

            <!-- Patient Table -->
            <div class="bg-white rounded-xl shadow-sm overflow-hidden">

                <div class="p-6 border-b border-gray-100">
                    <h2 class="text-2xl">Registered Patients</h2>
                    <p class="text-sm text-gray-500 mt-1">
                        Total records: @Model.Count()
                    </p>
                </div>

                <div class="overflow-x-auto">

                    <table class="w-full text-left text-sm">

                        <thead class="bg-[#f5f6f0] text-gray-600">
                            <tr>
                                <th class="px-6 py-4">ID</th>
                                <th class="px-6 py-4">Patient Name</th>
                                <th class="px-6 py-4">Gender</th>
                                <th class="px-6 py-4">Age</th>
                                <th class="px-6 py-4">Phone</th>
                                <th class="px-6 py-4">Registration Date</th>
                                <th class="px-6 py-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-100">

                            @if (Model.Any())
                            {
                                @foreach (var patient in Model)
                                {
                                    <tr class="hover:bg-gray-50">

                                        <td class="px-6 py-4">@patient.PatientId</td>

                                        <td class="px-6 py-4 font-semibold">
                                            @patient.FullName
                                        </td>

                                        <td class="px-6 py-4">@patient.Gender</td>

                                        <td class="px-6 py-4">@patient.Age</td>

                                        <td class="px-6 py-4">@patient.Phone</td>

                                        <td class="px-6 py-4">
                                            @patient.RegistrationDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td class="px-6 py-4">
                                            <div class="flex gap-3">

                                                <a href="/Patients/Edit/@patient.PatientId"
                                                   class="text-blue-600 font-semibold">
                                                    Edit
                                                </a>

                                                <form action="/Patients/Delete/@patient.PatientId"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to delete this patient?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="text-red-600 font-semibold">
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-12 text-gray-500">
                                        No patients found. Click Add Patient to register a new patient.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            </div>

            <footer class="text-center text-sm text-gray-400 mt-10">
                © 2026 AyurSutra. All Rights Reserved.
            </footer>

        </main>

    </div>

</body>
</html>
