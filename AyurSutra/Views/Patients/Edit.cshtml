@model AyurSutra.Models.Patient

@{
    Layout = null;
    ViewData["Title"] = "Edit Patient - AyurSutra";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Patient | AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'DM Sans', sans-serif;
        }

        h1, h2 {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>

<body class="bg-[#f5f6f0] text-[#263c2d]">

    <div class="max-w-4xl mx-auto px-5 py-12">

        <a href="/Patients/Index" class="text-[#39764d] font-semibold text-sm">
            ← Back to Patients
        </a>

        <div class="mt-7 mb-8">
            <p class="text-sm text-gray-500">Patient Management / Edit Patient</p>
            <h1 class="text-4xl mt-2">Update Patient Details</h1>
            <p class="text-gray-500 mt-2">
                Modify the registered patient's information.
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-7 md:p-10">

            <h2 class="text-2xl mb-7">Patient Information</h2>

            <form action="/Patients/Edit/@Model.PatientId" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="PatientId" value="@Model.PatientId" />
                <input type="hidden" name="RegistrationDate" value="@Model.RegistrationDate.ToString("o")" />

                <div class="mb-6">
                    <label class="block font-semibold text-sm mb-2">Full Name *</label>
                    <input type="text" name="FullName" value="@Model.FullName"
                           required
                           class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">
                </div>

                <div class="grid md:grid-cols-2 gap-6 mb-6">

                    <div>
                        <label class="block font-semibold text-sm mb-2">Gender *</label>
                        <select name="Gender" required
                                class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-white outline-none focus:border-[#39764d]">
                            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-sm mb-2">Age *</label>
                        <input type="number" name="Age" value="@Model.Age"
                               min="1" max="120" required
                               class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">
                    </div>

                </div>

                <div class="mb-6">
                    <label class="block font-semibold text-sm mb-2">Phone Number *</label>
                    <input type="tel" name="Phone" value="@Model.Phone"
                           pattern="[0-9]{10}" maxlength="10" required
                           class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">
                </div>

                <div class="mb-8">
                    <label class="block font-semibold text-sm mb-2">Address</label>
                    <textarea name="Address" rows="3"
                              class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">@Model.Address</textarea>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">

                    <button type="submit"
                            class="bg-[#285b3b] text-white px-8 py-3 rounded-lg font-semibold hover:bg-[#1e472d]">
                        Update Patient
                    </button>

                    <a href="/Patients/Index"
                       class="text-center border border-gray-300 px-8 py-3 rounded-lg font-semibold hover:bg-gray-50">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

        <footer class="text-center text-sm text-gray-400 mt-10">
            © 2026 AyurSutra. All Rights Reserved.
        </footer>

    </div>

</body>
</html>
