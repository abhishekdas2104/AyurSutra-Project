@model AyurSutra.Models.Doctor

@{
    Layout = null;
    ViewData["Title"] = "Edit Doctor";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Doctor - AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f7f8f2] text-gray-800">

    <div class="min-h-screen flex items-center justify-center p-6">

        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-lg p-8">

            <div class="mb-8">
                <a href="/Doctors/Index" class="text-[#315b47] hover:underline">
                    ← Back to Doctors
                </a>

                <h1 class="text-3xl font-bold text-[#183c2e] mt-5">Edit Doctor</h1>
                <p class="text-gray-500 mt-2">Update the doctor's professional details.</p>
            </div>

            <form method="post" action="/Doctors/Edit/@Model.DoctorId" class="space-y-5">

                @Html.AntiForgeryToken()

                <input type="hidden" name="DoctorId" value="@Model.DoctorId">

                <div>
                    <label class="block font-medium mb-2">Full Name</label>
                    <input type="text" name="FullName" value="@Model.FullName"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Specialization</label>
                    <input type="text" name="Specialization" value="@Model.Specialization"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Phone Number</label>
                    <input type="tel" name="Phone" value="@Model.Phone"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Email Address</label>
                    <input type="email" name="Email" value="@Model.Email"
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Qualification</label>
                    <input type="text" name="Qualification" value="@Model.Qualification"
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 bg-[#315b47] text-white py-3 rounded-lg hover:bg-[#183c2e] font-medium">
                        Update Doctor
                    </button>

                    <a href="/Doctors/Index"
                       class="flex-1 text-center border border-gray-300 py-3 rounded-lg hover:bg-gray-100">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</body>
</html>
