@model List<AyurSutra.Models.Doctor>

@{
    Layout = null;
    ViewData["Title"] = "Manage Doctors";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Doctors - AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f7f8f2] text-gray-800">

    <div class="flex min-h-screen">

        <aside class="w-64 bg-[#183c2e] text-white p-6">
            <h1 class="text-2xl font-bold mb-2">AyurSutra</h1>
            <p class="text-sm text-green-200 mb-10">Admin Panel</p>

            <nav class="space-y-3">
                <a href="/Dashboard/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Dashboard</a>
                <a href="/Patients/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Patients</a>
                <a href="/Doctors/Index" class="block p-3 rounded-lg bg-[#315b47]">Doctors</a>
                <a href="/Therapies/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Therapies</a>
                <a href="/Appointments/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Appointments</a>
                <a href="/TreatmentRecords/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Treatment Records</a>
                <a href="/Account/Logout" class="block p-3 rounded-lg hover:bg-red-700 mt-10">Logout</a>
            </nav>
        </aside>

        <main class="flex-1 p-8">

            <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-[#183c2e]">Doctor Management</h2>
                    <p class="text-gray-500 mt-2">Manage doctors and their professional details.</p>
                </div>

                <a href="/Doctors/Create"
                   class="bg-[#315b47] text-white px-6 py-3 rounded-lg hover:bg-[#183c2e]">
                    + Add New Doctor
                </a>
            </div>

            <div class="bg-white p-5 rounded-xl shadow-sm mb-6">
                <form method="get" action="/Doctors/Index" class="flex flex-wrap gap-3">
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.SearchString"
                           placeholder="Search by doctor name or specialization..."
                           class="flex-1 min-w-64 border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">

                    <button type="submit"
                            class="bg-[#315b47] text-white px-6 py-3 rounded-lg hover:bg-[#183c2e]">
                        Search
                    </button>

                    <a href="/Doctors/Index"
                       class="border border-gray-300 px-6 py-3 rounded-lg hover:bg-gray-100">
                        Reset
                    </a>
                </form>
            </div>

            <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="p-5 border-b">
                    <h3 class="text-xl font-semibold text-[#183c2e]">Doctors List</h3>
                    <p class="text-sm text-gray-500 mt-1">Total Doctors: @Model.Count</p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-[#edf2e9] text-[#183c2e]">
                            <tr>
                                <th class="p-4">ID</th>
                                <th class="p-4">Doctor Name</th>
                                <th class="p-4">Specialization</th>
                                <th class="p-4">Phone</th>
                                <th class="p-4">Email</th>
                                <th class="p-4">Qualification</th>
                                <th class="p-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Count > 0)
                            {
                                foreach (var doctor in Model)
                                {
                                    <tr class="border-t hover:bg-gray-50">
                                        <td class="p-4">@doctor.DoctorId</td>
                                        <td class="p-4 font-medium">@doctor.FullName</td>
                                        <td class="p-4">@doctor.Specialization</td>
                                        <td class="p-4">@doctor.Phone</td>
                                        <td class="p-4">@doctor.Email</td>
                                        <td class="p-4">@doctor.Qualification</td>
                                        <td class="p-4">
                                            <div class="flex gap-3">
                                                <a href="/Doctors/Edit/@doctor.DoctorId"
                                                   class="text-blue-600 hover:underline">Edit</a>

                                                <form method="post" action="/Doctors/Delete/@doctor.DoctorId"
                                                      onsubmit="return confirm('Are you sure you want to delete this doctor?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="text-red-600 hover:underline">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="p-8 text-center text-gray-500">
                                        No doctors found. Click "Add New Doctor" to register a doctor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

</body>
</html>
