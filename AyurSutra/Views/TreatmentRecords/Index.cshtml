@model List<AyurSutra.Models.TreatmentRecord>

@{
    Layout = null;
    ViewData["Title"] = "Treatment Records";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Treatment Records - AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f7f8f2] text-gray-800">

    <div class="flex min-h-screen">

        <aside class="w-64 bg-[#183c2e] text-white p-6">
            <h1 class="text-2xl font-bold mb-10">AyurSutra</h1>

            <nav class="space-y-3">
                <a href="/Dashboard/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Dashboard</a>
                <a href="/Patients/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Patients</a>
                <a href="/Doctors/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Doctors</a>
                <a href="/Therapies/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Therapies</a>
                <a href="/Appointments/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Appointments</a>
                <a href="/TreatmentRecords/Index" class="block p-3 rounded-lg bg-[#315b47]">Treatment Records</a>
                <a href="/Account/Logout" class="block p-3 rounded-lg hover:bg-red-700 mt-10">Logout</a>
            </nav>
        </aside>

        <main class="flex-1 p-8">

            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-[#183c2e]">Treatment Records</h2>
                    <p class="text-gray-500 mt-2">Manage patient treatment history.</p>
                </div>

                <a href="/TreatmentRecords/Create"
                   class="bg-[#315b47] text-white px-5 py-3 rounded-lg hover:bg-[#183c2e]">
                    + Add Treatment Record
                </a>
            </div>

            <div class="bg-white rounded-xl shadow-sm overflow-x-auto">

                <table class="w-full text-left">
                    <thead class="bg-[#edf2eb] text-[#183c2e]">
                        <tr>
                            <th class="p-4">Patient</th>
                            <th class="p-4">Therapy</th>
                            <th class="p-4">Treatment Date</th>
                            <th class="p-4">Status</th>
                            <th class="p-4">Observations</th>
                            <th class="p-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="p-6 text-center text-gray-500">
                                    No treatment records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var record in Model)
                            {
                                <tr class="border-t hover:bg-gray-50">
                                    <td class="p-4 font-medium">@record.Patient?.FullName</td>
                                    <td class="p-4">@record.Therapy?.TherapyName</td>
                                    <td class="p-4">@record.TreatmentDate.ToString("dd MMM yyyy")</td>
                                    <td class="p-4">
                                        <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">
                                            @record.Status
                                        </span>
                                    </td>
                                    <td class="p-4">@record.Observations</td>
                                    <td class="p-4 whitespace-nowrap">
                                        <a href="/TreatmentRecords/Edit/@record.RecordId"
                                           class="text-blue-700 hover:underline mr-3">Edit</a>

                                        <form method="post"
                                              action="/TreatmentRecords/Delete/@record.RecordId"
                                              class="inline"
                                              onsubmit="return confirm('Are you sure you want to delete this record?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-red-600 hover:underline">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>

        </main>
    </div>

</body>
</html>
