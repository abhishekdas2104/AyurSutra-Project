@{
    ViewData["Title"] = "About Us";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us | AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'DM Sans', sans-serif;
            color: #263d32;
        }

        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>
<body class="bg-[#faf9f5]">

    <nav class="bg-white px-6 py-5 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/Home/Index" class="text-2xl font-bold text-[#285943]">AyurSutra</a>
            <div class="flex flex-wrap gap-6 text-sm font-medium">
                <a href="/Home/Index">Home</a>
                <a href="/Home/About" class="text-[#285943]">About Us</a>
                <a href="/Home/Therapies">Therapies</a>
                <a href="/Home/Doctors">Our Doctors</a>
                <a href="/Home/Contact">Contact Us</a>
                <a href="/Account/Login">Login</a>
            </div>
        </div>
    </nav>

    <section class="bg-[#e9f0e8] py-20 px-6 text-center">
        <p class="text-sm uppercase tracking-[3px] text-[#66816b] mb-4">Discover AyurSutra</p>
        <h1 class="text-4xl md:text-6xl font-semibold text-[#285943] mb-6">
            Our Journey Towards Natural Wellness
        </h1>
        <p class="max-w-2xl mx-auto text-gray-600 leading-8">
            Bringing the timeless wisdom of Ayurveda into modern healthcare
            through personalized Panchakarma treatments and thoughtful care.
        </p>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-12 items-center">
        <div>
            <p class="text-sm uppercase tracking-widest text-[#789078] mb-3">Who We Are</p>
            <h2 class="text-4xl text-[#285943] mb-6">Healing Through the Wisdom of Ayurveda</h2>
            <p class="text-gray-600 leading-8 mb-5">
                AyurSutra is a Panchakarma patient management and therapy
                scheduling platform designed to make Ayurvedic healthcare
                more organized and accessible.
            </p>
            <p class="text-gray-600 leading-8">
                Our platform helps manage patient information, doctor details,
                therapy schedules, appointments and treatment records in one place.
                We aim to make the overall treatment management process simple,
                efficient and convenient.
            </p>
        </div>

        <div class="bg-[#e9f0e8] rounded-3xl p-10 text-center">
            <div class="text-7xl mb-5">🌿</div>
            <h3 class="text-3xl text-[#285943] mb-4">Balance. Care. Wellness.</h3>
            <p class="text-gray-600 leading-7">
                Inspired by the traditional principles of Ayurveda,
                AyurSutra focuses on organized care and a better
                treatment management experience.
            </p>
        </div>
    </section>

    <section class="bg-white py-20 px-6">
        <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
            <div class="bg-[#faf9f5] rounded-2xl p-10">
                <h2 class="text-3xl text-[#285943] mb-5">Our Mission</h2>
                <p class="text-gray-600 leading-8">
                    To simplify Panchakarma treatment management by providing
                    an organized platform for managing patients, doctors,
                    appointments and therapy records.
                </p>
            </div>

            <div class="bg-[#faf9f5] rounded-2xl p-10">
                <h2 class="text-3xl text-[#285943] mb-5">Our Vision</h2>
                <p class="text-gray-600 leading-8">
                    To support a more connected and efficient Ayurvedic
                    healthcare experience through simple and accessible
                    digital solutions.
                </p>
            </div>
        </div>
    </section>

    <footer class="bg-[#234b38] text-white text-center py-10 px-6">
        <h2 class="text-2xl font-semibold mb-3">AyurSutra</h2>
        <p class="text-sm text-gray-200 mb-4">Traditional Healing. Natural Wellness.</p>
        <p class="text-xs text-gray-300">&copy; 2026 AyurSutra. All Rights Reserved.</p>
    </footer>

</body>
</html>
