@{
    ViewData["Title"] = "Our Therapies";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Therapies | AyurSutra</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'DM Sans', sans-serif;
            color: #263d32;
        }

        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>

<body class="bg-[#faf9f5]">

    <!-- Navbar -->
    <nav class="bg-white px-6 py-5 shadow-sm">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/Home/Index" class="text-2xl font-bold text-[#285943]">AyurSutra</a>

            <div class="flex flex-wrap gap-6 text-sm font-medium">
                <a href="/Home/Index">Home</a>
                <a href="/Home/About">About Us</a>
                <a href="/Home/Therapies" class="text-[#285943]">Therapies</a>
                <a href="/Home/Doctors">Our Doctors</a>
                <a href="/Home/Contact">Contact Us</a>
                <a href="/Account/Login">Login</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="bg-[#e9f0e8] py-20 px-6 text-center">
        <p class="text-sm uppercase tracking-[3px] text-[#66816b] mb-4">
            Natural Healing
        </p>

        <h1 class="text-4xl md:text-6xl font-semibold text-[#285943] mb-6">
            Explore Our Panchakarma Therapies
        </h1>

        <p class="max-w-2xl mx-auto text-gray-600 leading-8">
            Discover traditional Ayurvedic therapies designed to support
            relaxation, balance and overall wellness.
        </p>
    </section>

    <!-- Introduction -->
    <section class="max-w-4xl mx-auto px-6 py-16 text-center">
        <h2 class="text-3xl md:text-4xl text-[#285943] mb-5">
            The Art of Ayurvedic Healing
        </h2>

        <p class="text-gray-600 leading-8">
            Panchakarma is a traditional Ayurvedic approach involving
            specialized therapeutic procedures. Each therapy is selected
            according to individual needs and guided by qualified practitioners.
            Explore some of the well-known therapies below.
        </p>
    </section>

    <!-- Therapy Cards -->
    <section class="max-w-7xl mx-auto px-6 pb-20">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                <div class="bg-[#e9f0e8] h-48 flex items-center justify-center text-7xl">
                    🌿
                </div>
                <div class="p-7">
                    <h3 class="text-2xl text-[#285943] mb-3">Abhyanga</h3>
                    <p class="text-gray-600 leading-7">
                        A traditional Ayurvedic full-body massage using
                        herbal oils and gentle massage techniques.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                <div class="bg-[#e9f0e8] h-48 flex items-center justify-center text-7xl">
                    💧
                </div>
                <div class="p-7">
                    <h3 class="text-2xl text-[#285943] mb-3">Shirodhara</h3>
                    <p class="text-gray-600 leading-7">
                        A traditional procedure involving a gentle,
                        continuous stream of warm oil over the forehead.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                <div class="bg-[#e9f0e8] h-48 flex items-center justify-center text-7xl">
                    🌸
                </div>
                <div class="p-7">
                    <h3 class="text-2xl text-[#285943] mb-3">Swedana</h3>
                    <p class="text-gray-600 leading-7">
                        An Ayurvedic herbal steam therapy traditionally
                        used alongside other treatment procedures.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                <div class="bg-[#e9f0e8] h-48 flex items-center justify-center text-7xl">
                    🍃
                </div>
                <div class="p-7">
                    <h3 class="text-2xl text-[#285943] mb-3">Basti</h3>
                    <p class="text-gray-600 leading-7">
                        A specialized Ayurvedic procedure involving
                        the administration of prescribed herbal preparations.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                <div class="bg-[#e9f0e8] h-48 flex items-center justify-center text-7xl">
                    🌼
                </div>
                <div class="p-7">
                    <h3 class="text-2xl text-[#285943] mb-3">Nasya</h3>
                    <p class="text-gray-600 leading-7">
                        A traditional Ayurvedic procedure involving
                        the administration of prescribed preparations through the nose.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                <div class="bg-[#e9f0e8] h-48 flex items-center justify-center text-7xl">
                    🪷
                </div>
                <div class="p-7">
                    <h3 class="text-2xl text-[#285943] mb-3">Virechana</h3>
                    <p class="text-gray-600 leading-7">
                        A traditional Panchakarma procedure involving
                        medically supervised therapeutic purgation.
                    </p>
                </div>
            </div>

        </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#e9f0e8] py-16 px-6 text-center">
        <h2 class="text-3xl md:text-4xl text-[#285943] mb-5">
            Find the Right Therapy for You
        </h2>

        <p class="text-gray-600 mb-8">
            Consult a qualified Ayurvedic practitioner before choosing a therapy.
        </p>

        <a href="/Home/Contact"
           class="inline-block bg-[#285943] text-white px-8 py-3 rounded-lg hover:bg-[#1d4431] transition">
            Contact Us
        </a>
    </section>

    <!-- Footer -->
    <footer class="bg-[#234b38] text-white text-center py-10 px-6">
        <h2 class="text-2xl font-semibold mb-3">AyurSutra</h2>
        <p class="text-sm text-gray-200 mb-4">
            Traditional Healing. Natural Wellness.
        </p>
        <p class="text-xs text-gray-300">
            &copy; 2026 AyurSutra. All Rights Reserved.
        </p>
    </footer>

</body>
</html>
