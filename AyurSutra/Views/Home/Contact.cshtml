@{
    Layout = null;
    ViewData["Title"] = "Contact Us - AyurSutra";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'DM Sans', sans-serif;
        }

        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>
<body class="bg-[#f8f7f0] text-[#263c2d]">

    <nav class="bg-white px-8 py-5 flex justify-between items-center shadow-sm">
        <a href="/Home/Index" class="text-2xl font-bold text-[#285b3b]">AyurSutra</a>
        <div class="flex flex-wrap gap-6 text-sm font-medium">
            <a href="/Home/Index">Home</a>
            <a href="/Home/About">About Us</a>
            <a href="/Home/Therapies">Therapies</a>
            <a href="/Home/Doctors">Our Doctors</a>
            <a href="/Home/Contact" class="text-[#39764d] font-bold">Contact Us</a>
            <a href="/Account/Login" class="bg-[#285b3b] text-white px-5 py-2 rounded-full">Login</a>
        </div>
    </nav>

    <section class="bg-[#285b3b] text-white text-center py-20 px-6">
        <p class="uppercase tracking-[3px] text-sm text-[#c8d9b9] mb-4">We are here to help</p>
        <h1 class="text-5xl mb-5">Get in Touch</h1>
        <p class="max-w-2xl mx-auto text-[#e0e9dc] leading-relaxed">
            Have questions about our therapies or want to schedule a consultation?
            We would be happy to hear from you.
        </p>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-2 gap-12">

        <div>
            <h2 class="text-3xl mb-4">Let's Connect</h2>
            <p class="text-gray-600 leading-7 mb-8">
                Our team is available to help you understand our treatments,
                appointment process and wellness services.
            </p>

            <div class="space-y-6">
                <div class="bg-white p-5 rounded-xl shadow-sm">
                    <h3 class="text-lg font-semibold mb-2">Our Location</h3>
                    <p class="text-gray-600">AyurSutra Wellness Centre</p>
                </div>

                <div class="bg-white p-5 rounded-xl shadow-sm">
                    <h3 class="text-lg font-semibold mb-2">Phone Number</h3>
                    <p class="text-gray-600">Contact details available at reception</p>
                </div>

                <div class="bg-white p-5 rounded-xl shadow-sm">
                    <h3 class="text-lg font-semibold mb-2">Working Hours</h3>
                    <p class="text-gray-600">Monday – Saturday</p>
                    <p class="text-gray-600">9:00 AM – 6:00 PM</p>
                </div>
            </div>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm">
            <h2 class="text-3xl mb-2">Send Us a Message</h2>
            <p class="text-gray-500 mb-7">Fill in the details below and our team will get back to you.</p>

            <form>
                <div class="mb-5">
                    <label class="block text-sm font-semibold mb-2">Full Name</label>
                    <input type="text" placeholder="Enter your name"
                           class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-semibold mb-2">Email Address</label>
                    <input type="email" placeholder="Enter your email"
                           class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-semibold mb-2">Subject</label>
                    <input type="text" placeholder="Enter subject"
                           class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]">
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-semibold mb-2">Message</label>
                    <textarea rows="4" placeholder="Write your message..."
                              class="w-full border border-gray-200 rounded-lg px-4 py-3 outline-none focus:border-[#39764d]"></textarea>
                </div>

                <button type="button"
                        class="w-full bg-[#285b3b] text-white py-3 rounded-lg font-semibold hover:bg-[#1e472d]">
                    Send Message
                </button>
            </form>
        </div>

    </section>

    <footer class="bg-[#203c2b] text-white text-center py-8">
        <h2 class="text-2xl mb-2">AyurSutra</h2>
        <p class="text-sm text-gray-300">Traditional Healing. Natural Wellness.</p>
        <p class="text-xs text-gray-400 mt-4">© 2026 AyurSutra. All Rights Reserved.</p>
    </footer>

</body>
</html>
