@model AyurSutra.Models.Appointment

@{
    Layout = null;
    ViewData["Title"] = "Schedule Appointment";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule Appointment - AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f7f8f2] text-gray-800">

    <div class="min-h-screen flex items-center justify-center p-6">

        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-lg p-8">

            <div class="mb-8">
                <a href="/Appointments/Index" class="text-[#315b47] hover:underline">
                    ← Back to Appointments
                </a>

                <h1 class="text-3xl font-bold text-[#183c2e] mt-5">Schedule Appointment</h1>
                <p class="text-gray-500 mt-2">Select a patient, doctor and therapy to schedule an appointment.</p>
            </div>

            <form method="post" action="/Appointments/Create" class="space-y-5">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

                <div>
                    <label class="block font-medium mb-2">Select Patient</label>
                    <select name="PatientId" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-green-600">
                        <option value="">-- Select Patient --</option>
                        @foreach (var patient in (IEnumerable<SelectListItem>)ViewBag.Patients)
                        {
                            <option value="@patient.Value" selected="@(Model?.PatientId.ToString() == patient.Value)">
                                @patient.Text
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-medium mb-2">Select Doctor</label>
                    <select name="DoctorId" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-green-600">
                        <option value="">-- Select Doctor --</option>
                        @foreach (var doctor in (IEnumerable<SelectListItem>)ViewBag.Doctors)
                        {
                            <option value="@doctor.Value" selected="@(Model?.DoctorId.ToString() == doctor.Value)">
                                @doctor.Text
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-medium mb-2">Select Therapy</label>
                    <select name="TherapyId" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-green-600">
                        <option value="">-- Select Therapy --</option>
                        @foreach (var therapy in (IEnumerable<SelectListItem>)ViewBag.Therapies)
                        {
                            <option value="@therapy.Value" selected="@(Model?.TherapyId.ToString() == therapy.Value)">
                                @therapy.Text
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-medium mb-2">Appointment Date & Time</label>
                    <input type="datetime-local" name="AppointmentDate"
                           value="@(Model?.AppointmentDate == default ? "" : Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm"))"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Appointment Status</label>
                    <select name="Status"
                            class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-green-600">
                        <option value="Pending" selected="@(Model?.Status == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(Model?.Status == "Confirmed")">Confirmed</option>
                        <option value="Completed" selected="@(Model?.Status == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model?.Status == "Cancelled")">Cancelled</option>
                    </select>
                </div>

                <div>
                    <label class="block font-medium mb-2">Notes</label>
                    <textarea name="Notes" rows="3"
                              placeholder="Enter any additional appointment notes..."
                              class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">@Model?.Notes</textarea>
                </div>

                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 bg-[#315b47] text-white py-3 rounded-lg hover:bg-[#183c2e] font-medium">
                        Save Appointment
                    </button>

                    <a href="/Appointments/Index"
                       class="flex-1 text-center border border-gray-300 py-3 rounded-lg hover:bg-gray-100">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</body>
</html>
