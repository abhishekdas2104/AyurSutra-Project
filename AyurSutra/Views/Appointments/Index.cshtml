@model List<AyurSutra.Models.Appointment>

@{
    Layout = null;
    ViewData["Title"] = "Manage Appointments";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appointments - AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f7f8f2] text-gray-800">

    <div class="flex min-h-screen">

        <aside class="w-64 bg-[#183c2e] text-white p-6">
            <h1 class="text-2xl font-bold mb-2">AyurSutra</h1>
            <p class="text-sm text-green-200 mb-10">Admin Panel</p>

            <nav class="space-y-3">
                <a href="/Dashboard/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Dashboard</a>
                <a href="/Patients/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Patients</a>
                <a href="/Doctors/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Doctors</a>
                <a href="/Therapies/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Therapies</a>
                <a href="/Appointments/Index" class="block p-3 rounded-lg bg-[#315b47]">Appointments</a>
                <a href="/TreatmentRecords/Index" class="block p-3 rounded-lg hover:bg-[#315b47]">Treatment Records</a>
                <a href="/Account/Logout" class="block p-3 rounded-lg hover:bg-red-700 mt-10">Logout</a>
            </nav>
        </aside>

        <main class="flex-1 p-8">

            <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-[#183c2e]">Appointment Management</h2>
                    <p class="text-gray-500 mt-2">Schedule and manage patient therapy appointments.</p>
                </div>

                <a href="/Appointments/Create"
                   class="bg-[#315b47] text-white px-6 py-3 rounded-lg hover:bg-[#183c2e]">
                    + Schedule Appointment
                </a>
            </div>

            <div class="bg-white rounded-xl shadow-sm overflow-hidden">

                <div class="p-5 border-b">
                    <h3 class="text-xl font-semibold text-[#183c2e]">Appointments List</h3>
                    <p class="text-sm text-gray-500 mt-1">Total Appointments: @Model.Count</p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">

                        <thead class="bg-[#edf2e9] text-[#183c2e]">
                            <tr>
                                <th class="p-4">ID</th>
                                <th class="p-4">Patient</th>
                                <th class="p-4">Doctor</th>
                                <th class="p-4">Therapy</th>
                                <th class="p-4">Date & Time</th>
                                <th class="p-4">Status</th>
                                <th class="p-4">Notes</th>
                                <th class="p-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Count > 0)
                            {
                                foreach (var appointment in Model)
                                {
                                    <tr class="border-t hover:bg-gray-50">
                                        <td class="p-4">@appointment.AppointmentId</td>
                                        <td class="p-4 font-medium">@(appointment.Patient?.FullName ?? "N/A")</td>
                                        <td class="p-4">@(appointment.Doctor?.FullName ?? "N/A")</td>
                                        <td class="p-4">@(appointment.Therapy?.TherapyName ?? "N/A")</td>
                                        <td class="p-4">@appointment.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="p-4">
                                            <span class="px-3 py-1 rounded-full text-sm
                                                @(appointment.Status == "Completed" ? "bg-green-100 text-green-700" :
  appointment.Status == "Cancelled" ? "bg-red-100 text-red-700" :
  appointment.Status == "Confirmed" ? "bg-blue-100 text-blue-700" :
  "bg-yellow-100 text-yellow-700")">
                                                @appointment.Status
                                            </span>
                                        </td>
                                        <td class="p-4">@(string.IsNullOrEmpty(appointment.Notes) ? "-" : appointment.Notes)</td>
                                        <td class="p-4">
                                            <div class="flex gap-3">
                                                <a href="/Appointments/Edit/@appointment.AppointmentId"
                                                   class="text-blue-600 hover:underline">Edit</a>

                                                <form method="post" action="/Appointments/Delete/@appointment.AppointmentId"
                                                      onsubmit="return confirm('Are you sure you want to delete this appointment?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="text-red-600 hover:underline">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="p-8 text-center text-gray-500">
                                        No appointments found. Click "Schedule Appointment" to add one.
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>

        </main>
    </div>

</body>
</html>
