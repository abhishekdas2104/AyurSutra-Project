@model AyurSutra.Models.Therapy

@{
    Layout = null;
    ViewData["Title"] = "Add Therapy";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Therapy - AyurSutra</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f7f8f2] text-gray-800">

    <div class="min-h-screen flex items-center justify-center p-6">

        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-lg p-8">

            <div class="mb-8">
                <a href="/Therapies/Index" class="text-[#315b47] hover:underline">
                    ← Back to Therapies
                </a>

                <h1 class="text-3xl font-bold text-[#183c2e] mt-5">Add New Therapy</h1>
                <p class="text-gray-500 mt-2">Enter the details of the Ayurvedic therapy.</p>
            </div>

            <form method="post" action="/Therapies/Create" class="space-y-5">

                @Html.AntiForgeryToken()

                <div>
                    <label class="block font-medium mb-2">Therapy Name</label>
                    <input type="text" name="TherapyName" value="@Model?.TherapyName"
                           placeholder="e.g. Abhyanga"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Description</label>
                    <textarea name="Description" rows="4"
                              placeholder="Enter a short description of the therapy"
                              class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">@Model?.Description</textarea>
                </div>

                <div>
                    <label class="block font-medium mb-2">Duration (in minutes)</label>
                    <input type="number" name="Duration" value="@(Model?.Duration)"
                           placeholder="e.g. 60"
                           min="1"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div>
                    <label class="block font-medium mb-2">Price (₹)</label>
                    <input type="number" name="Price" value="@(Model?.Price)"
                           placeholder="e.g. 1500"
                           min="0"
                           step="0.01"
                           required
                           class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600">
                </div>

                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 bg-[#315b47] text-white py-3 rounded-lg hover:bg-[#183c2e] font-medium">
                        Save Therapy
                    </button>

                    <a href="/Therapies/Index"
                       class="flex-1 text-center border border-gray-300 py-3 rounded-lg hover:bg-gray-100">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</body>
</html>
